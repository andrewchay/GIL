{
  "name": "gil-language",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "demo:agent": "node src/cli.ts demo-agent",
    "serve:agent": "node src/agent-server.ts",
    "demo:workspace": "node src/cli.ts demo-workspace",
    "demo:evaluation": "node src/cli.ts demo-evaluation",
    "demo:rl": "node src/cli.ts demo-rl",
    "demo:governance": "node src/cli.ts demo-governance",
    "demo:assurance": "node src/cli.ts demo-assurance",
    "demo:delegation": "node src/cli.ts demo-delegation",
    "clarify:clinical": "node src/cli.ts clarify docs/clinical-operations/monitoring-remediation/interpretation.gil conformance/clinical-interpretation.json",
    "demo:clarification": "node src/cli.ts clarify docs/clinical-operations/monitoring-remediation/interpretation.gil conformance/clinical-interpretation.json --demo-answer",
    "check:clinical": "node src/cli.ts check docs/clinical-operations/monitoring-remediation/workflow.gil docs/clinical-operations/monitoring-remediation/ontology.gil",
    "demo:clinical": "node src/cli.ts simulate docs/clinical-operations/monitoring-remediation/workflow.gil docs/clinical-operations/monitoring-remediation/ontology.gil conformance/clinical-core.json",
    "parse:examples": "node src/cli.ts parse examples/酒店预订.gil && node src/cli.ts parse examples/机器人导航.gil"
  }
}
