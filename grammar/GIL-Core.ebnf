(* GIL-Core v0.1 具体语法草案
   规范对象是由本语法生成的带类型 AST。
   词法细节、标准库和完整错误恢复规则留待实现规范。 *)

document        ::= ontologyDef | lexiconDef | specification | interpretationDef ;

(* 一个文件可携带多个互不嵌套的顶层文档：规范仓库的示例文件把 spec、
   interpretation 与 delegation 放在一起。单文档入口仍只接受一个。 *)
bundle          ::= documentEntry+ ;
documentEntry   ::= document | delegationDef ;

ontologyDef     ::= "ontology" string "version" string
                    "{" ontologyItem* "}" ;
ontologyItem    ::= conceptDecl | relationDecl | constraintDecl | typeDecl ;
conceptDecl     ::= "concept" name "{" conceptMember* "}" ;
conceptMember   ::= "identity" name ":" typeExpr ";"
                  | fieldDecl
                  | constraintDecl ;
relationDecl    ::= "relation" name "(" parameters? ")" ":" typeExpr
                    ("=" expression)? ";" ;
constraintDecl  ::= "constraint" name ":" expression ";" ;
fieldDecl       ::= name ":" typeExpr ";" ;

lexiconDef      ::= "lexicon" string "version" string "for" string
                    "{" lexiconEntry* "}" ;
lexiconEntry    ::= "phrase" string "=>"
                    ("candidate" reference | "candidates" referenceList) ";" ;

specification   ::= "spec" qualifiedName "version" string
                    "{" importDecl* section* "}" ;
importDecl      ::= "use" ("ontology" | "lexicon") string ("as" name)? ";" ;
section         ::= contextSection | inputSection | outputSection | stateSection
                  | knowledgeSection | goalsSection | constraintsSection
                  | actionSection | verificationSection ;

contextSection  ::= "context" "{" contextBinding* "}" ;
contextBinding  ::= name ":" typeExpr ("=" expression)? provenance? ";" ;
inputSection    ::= "input" "{" typedDecl* "}" ;
outputSection   ::= "output" "{" typedDecl* "}" ;
stateSection    ::= "state" "{" typedDecl* "}" ;
typedDecl       ::= name ":" typeExpr ("=" expression)? ";" ;
typeDecl        ::= "type" name "=" typeExpr ";" ;

knowledgeSection ::= "knowledge" "{" knowledgeItem* "}" ;
knowledgeItem   ::= ("assert" | "assume") name ":" expression provenance? ";"
                  | "open" name ":" typeExpr ";"
                  | "ambiguous" name "{" "candidates" referenceList ";" "}"
                  | "disputed" name ":" expression provenance? ";"
                  | "operationalize" string "as" expression ";" ;
provenance      ::= "source" expression
                    ("as" ("asserted" | "assumed" | "inferred" | "disputed"))? ;

goalsSection    ::= "goals" "{" goalDecl* "}" ;
goalDecl        ::= "achieve" name ":" expression ";"
                  | "prefer" name ":" ("minimize" | "maximize") expression
                    "priority" integer ";" ;
constraintsSection
                ::= "constraints" "{" requireDecl* "}" ;
requireDecl     ::= "require" name ":" expression ";" ;

actionSection   ::= "action" "{" actionDecl* "}" ;
actionDecl      ::= "action" name "(" parameters? ")" ("->" typeExpr)?
                    actionClause* ";" ;
actionClause    ::= "requires" expression
                  | "ensures" expression
                  | "writes" referenceList
                  | "preserves" expression
                  | "outcomes" "{" outcomeDecl* "}"
                  | "failure" nameList
                  | "atomic"
                  | "retryable" boolean
                  | "reversibility" ("reversible" | "compensable" | "irreversible")
                  | "compensate" expression ;
outcomeDecl     ::= decimal "->" expression ";" ;

verificationSection
                ::= "verification" "{" verificationDecl* "}" ;
verificationDecl
                ::= "verify" reference "by" verifierCall
                    ("under" referenceList)? ";" ;
verifierCall    ::= qualifiedName "(" arguments? ")" ;

interpretationDef
                ::= "interpretation" name "of" string
                    "{" importDecl* interpretationItem* "}" ;
interpretationItem
                ::= "ground" sourceRef "->" expression provenance? ";"
                  | "assume" name ":" expression provenance? ";"
                  | knowledgeItem ;
sourceRef       ::= name "(" arguments? ")" ;

parameters      ::= parameter ("," parameter)* ;
parameter       ::= name ":" typeExpr ;
arguments       ::= expression ("," expression)* ;
referenceList   ::= reference ("," reference)* ;
nameList        ::= name ("," name)* ;
reference       ::= qualifiedName ;

typeExpr        ::= unionType ;
unionType       ::= postfixType ("|" postfixType)* ;
postfixType     ::= primaryType ("<" typeArguments ">" | "?")* ;
primaryType     ::= qualifiedName
                  | "{" name ":" typeExpr "|" expression "}"
                  | "(" typeExpr ")" ;
typeArguments   ::= typeExpr ("," typeExpr)* ;

(* 表达式按优先级组织；时序表达式和量词属于 prefixExpr。 *)
expression      ::= implicationExpr ;
implicationExpr ::= orExpr ("=>" implicationExpr)? ;
orExpr          ::= andExpr ("||" andExpr)* ;
andExpr         ::= equalityExpr ("&&" equalityExpr)* ;
equalityExpr    ::= relationalExpr (("==" | "!=") relationalExpr)* ;
relationalExpr  ::= additiveExpr (("<" | "<=" | ">" | ">=" | "in") additiveExpr)* ;
additiveExpr    ::= multiplicativeExpr (("+" | "-") multiplicativeExpr)* ;
multiplicativeExpr
                ::= unaryExpr (("*" | "/") unaryExpr)* ;
unaryExpr       ::= ("!" | "-" | "not") unaryExpr | temporalExpr ;
(* always / eventually 绑定到比较级（equalityExpr）：
   `always a == b` 即 `always (a == b)`；`&&`、`||`、`=>` 在其外，需要括号才能包进去。
   Core 与 RL 共用这条规则。 *)
temporalExpr    ::= ("always" | "eventually") equalityExpr
                  | "eventually" "within" unitLiteral equalityExpr
                  | ("entered" | "changed") unaryExpr
                  | "after" expression unaryExpr
                  | quantifierExpr
                  | postfixExpr ;
(* 绑定名可用逗号或空白分隔：`forall b1 b2: H.Booking. e`。
   类型后的 "." 与限定名里的 "." 同形，取舍依据命名约定：
   类型最多两段且第二段首字母大写，绑定变量名小写。 *)
quantifierExpr  ::= ("forall" | "exists") nameList ":" typeExpr "." expression ;
postfixExpr     ::= primaryExpr postfixOp* ;
postfixOp       ::= "." name | "'" | "(" arguments? ")" | "[" expression "]" ;
primaryExpr     ::= literal | reference | sourceRef
                  | "(" expression ")"
                  | "{" expressionList? "}" ;
expressionList  ::= expression ("," expression)* ;
literal         ::= string | decimal | integer | boolean | unitLiteral ;
unitLiteral     ::= decimal "." name | integer "." name ;

qualifiedName   ::= name ("." name)* ;
name            ::= identifier ;
boolean         ::= "true" | "false" ;
identifier      ::= letter (letter | digit | "_")* ;
integer         ::= digit+ ;
decimal         ::= digit+ "." digit+ ;
string          ::= "\"" stringCharacter* "\"" ;
letter          ::= "A"…"Z" | "a"…"z" | "_" ;
digit           ::= "0"…"9" ;
stringCharacter ::= (* 除未转义双引号外的字符，转义规则由实现规范定义 *) ;

(* ─────────────────────────────────────────────────────────────────────────
   GIL-Delegation 的请求语法。
   这里的 scope、budget、autonomy 都是请求的一部分，不是执行授权；
   真正许可由 Grant 与 bound plan 在运行期判定。
   ───────────────────────────────────────────────────────────────────────── *)
delegationDef   ::= "delegate" name "(" delegationParams? ")" "to" reference
                    "within" reference delegationClause* ";" ;
delegationParams
                ::= delegationParam ("," delegationParam)* ;
delegationParam ::= name (":" typeExpr)? ;
delegationClause
                ::= "autonomy" ("supervised" | "bounded" | "autonomous")
                  | "budget" decimal "." name
                  | "requires" expression
                  | "requiresEvidence" referenceList
                  | "approval" reference "when" expression
                  | "onConflict" handler
                  | "onUncertainty" handler
                  | "revokeBy" reference
                  | "expires" decimal "." name "after" reference ;
(* 动词加可选目标：`ask customer`、`escalate`。 *)
handler         ::= name name* ;

(* ─────────────────────────────────────────────────────────────────────────
   GIL-RL 的环境语法（06-GIL-RL.md）。
   它有意不并入 Core 文档：`in` 与 `within N.steps` 只在环境文档中启用。
   ───────────────────────────────────────────────────────────────────────── *)
environmentDef  ::= "environment" qualifiedName "version" string
                    "{" environmentSection* "}" ;
environmentSection
                ::= "state" "{" typedDecl* "}"
                  | "observation" "{" observationItem* "}"
                  | "initial" "{" initialDecl* "}"
                  | "action" "{" rlActionDecl* "}"
                  | "termination" "{" terminationClause* "}"
                  | "goals" "{" rlGoalDecl* "}"
                  | "constraints" "{" rlRequireDecl* "}"
                  | "reward" "{" rewardClause* "}"
                  | "objective" "{" "maximize" name "subjectTo" nameList ";" "}" ;
initialDecl     ::= expression ";" ;
rlGoalDecl      ::= "achieve" name ":" expression ";" ;
rlRequireDecl   ::= "require" name ":" expression ";" ;
(* 首版只支持 `fullState;` 或裸可见变量名。 *)
observationItem ::= (name | "fullState") ";" ;
terminationClause
                ::= ("success" | "failure" | "cutoff") "when" expression ";" ;
rewardClause    ::= "discount" decimal ";"
                  | "horizon" integer "." "steps" ";"
                  | "aggregation" name ";"
                  | "term" name ":" signedNumber rewardTiming ;
rewardTiming    ::= "once" "entered" "(" expression ")" ";"
                  | "per" "step" ";" ;
signedNumber    ::= ("-" | "+")? (integer | decimal) ;
rlActionDecl    ::= "action" name "(" parameters? ")"
                    rlActionClause* ";" ;
rlActionClause  ::= "requires" expression
                  | "ensures" expression
                  | "writes" referenceList
                  | "atomic"
                  | "outcomes" "{" rlOutcomeDecl* "}" ;
rlOutcomeDecl   ::= decimal "->" expression ";" ;
